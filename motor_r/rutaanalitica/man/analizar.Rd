\name{analizar}
\alias{analizar}
\title{Calcular una ruta estadística validada}
\description{Aplica una de las rutas permitidas a columnas internas y devuelve cifras, exclusiones e interpretación en español.}
\usage{analizar(solicitud, datos, directorio)}
\arguments{\item{solicitud}{Lista del contrato versión 1.}\item{datos}{Marco de datos con identificadores internos.}\item{directorio}{Carpeta de salida para figura.png.}}
\value{Lista con cifras, tablas, recuentos, exclusiones, advertencias y procedencia.}
