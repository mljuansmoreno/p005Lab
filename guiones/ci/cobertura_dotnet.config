<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*RutaEstadistica\.(Contratos|Dominio|Aplicacion|Infraestructura)\.dll$</ModulePath>
      </Include>
      <Exclude>
        <ModulePath>.*PruebasUnitarias\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
  </CodeCoverage>
</Configuration>
