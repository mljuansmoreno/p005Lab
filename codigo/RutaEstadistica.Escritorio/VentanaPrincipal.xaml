<Window x:Class="RutaEstadistica.Escritorio.VentanaPrincipal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ruta Estadística">
<Grid Padding="24" RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock x:Uid="NombreAplicacion" Text="Ruta Estadística" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Text="De tu pregunta a una evidencia que puedes explicar"/></StackPanel>
<NavigationView x:Name="Navegacion" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Left" SelectionChanged="CambiarPaso">
<NavigationView.MenuItems>
<NavigationViewItem Content="Inicio y proyectos" Tag="0" Icon="Home"/><NavigationViewItem Content="1 · Pregunta" Tag="1" Icon="Help"/><NavigationViewItem Content="2 · Datos" Tag="2" Icon="OpenFile"/><NavigationViewItem Content="3 · Preparación" Tag="3" Icon="Edit"/><NavigationViewItem Content="4 · Ruta" Tag="4" Icon="Map"/><NavigationViewItem Content="5 · Resultados" Tag="5" Icon="View"/><NavigationViewItem Content="6 · Interpretación" Tag="6" Icon="Message"/><NavigationViewItem Content="7 · Evidencia y exportación" Tag="7" Icon="Save"/><NavigationViewItem Content="Configuración y ayuda" Tag="8" Icon="Setting"/>
</NavigationView.MenuItems>
<ScrollViewer><StackPanel Spacing="16" Margin="24,0" MaxWidth="1000" HorizontalAlignment="Stretch">
<StackPanel x:Name="PanelInicio" Spacing="12"><TextBlock Text="Tus proyectos" Style="{ThemeResource SubtitleTextBlockStyle}"/><TextBox x:Name="NombreProyecto" Header="Nombre del proyecto" Text="Mi análisis"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Crear proyecto" Click="CrearProyecto"/><Button Content="Probar ejemplo" Click="ProbarEjemplo"/><Button Content="Importar proyecto" Click="ImportarProyecto"/></StackPanel><ComboBox x:Name="ListaProyectos" Header="Proyectos guardados" DisplayMemberPath="Nombre" SelectionChanged="AbrirProyecto" HorizontalAlignment="Stretch"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Renombrar" Click="RenombrarProyecto"/><Button Content="Duplicar" Click="DuplicarProyecto"/><Button Content="Eliminar con respaldo" Click="EliminarProyecto"/></StackPanel><TextBlock Text="Los datos se guardan en tu perfil de Windows. No se envían a servicios externos. Los proyectos no están cifrados por esta aplicación." TextWrapping="Wrap"/></StackPanel>
<StackPanel x:Name="PanelPregunta" Visibility="Collapsed" Spacing="12"><TextBlock Text="¿Qué necesitas averiguar?" Style="{ThemeResource SubtitleTextBlockStyle}"/><TextBox x:Name="Pregunta" Header="Pregunta" AcceptsReturn="True" TextChanged="GuardarContexto"/><TextBox x:Name="Contexto" Header="Población, unidades y diseño de muestreo" AcceptsReturn="True" TextChanged="GuardarContexto"/><TextBlock Text="Una muestra de conveniencia permite describir los registros; no demuestra que representen a toda una población." TextWrapping="Wrap"/></StackPanel>
<StackPanel x:Name="PanelDatos" Visibility="Collapsed" Spacing="12" AllowDrop="True" DragOver="ArrastrarArchivo" Drop="SoltarArchivo"><TextBlock Text="Importar y confirmar" Style="{ThemeResource SubtitleTextBlockStyle}"/><TextBlock Text="CSV/TSV UTF-8 o XLSX sin fórmulas. Máximo 50 MiB, 100.000 filas sin contar cabecera y 200 columnas. También puedes soltar aquí un archivo." TextWrapping="Wrap"/><Button Content="Seleccionar archivo" Click="SeleccionarArchivo"/><TextBlock x:Name="ArchivoElegido" Text="Ningún archivo seleccionado"/><ComboBox x:Name="Hojas" Header="Hoja del libro (confirma una)" HorizontalAlignment="Stretch"/><StackPanel Orientation="Horizontal" Spacing="12"><ComboBox x:Name="Separador" Header="Separador" SelectedIndex="0"><ComboBoxItem Content="Punto y coma"/><ComboBoxItem Content="Coma"/><ComboBoxItem Content="Tabulación"/></ComboBox><ComboBox x:Name="Decimal" Header="Decimal" SelectedIndex="0"><ComboBoxItem Content="Coma"/><ComboBoxItem Content="Punto"/></ComboBox><ComboBox x:Name="Miles" Header="Miles" SelectedIndex="0"><ComboBoxItem Content="Sin separador"/><ComboBoxItem Content="Punto"/><ComboBoxItem Content="Coma"/></ComboBox></StackPanel><TextBox x:Name="MarcadorFaltante" Header="Marcador faltante" Text="NA"/><CheckBox x:Name="TieneCabecera" Content="Primera fila contiene encabezados" IsChecked="True"/><TextBox x:Name="FormatoFecha" Header="Formato de fecha explícito" Text="dd/MM/yyyy"/><Button Content="Confirmar opciones y ver vista previa" Click="ImportarDatos"/><TextBox x:Name="VistaPrevia" Header="Vista previa (máximo 200 filas)" AcceptsReturn="True" IsReadOnly="True" MaxHeight="320" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/></StackPanel>
<StackPanel x:Name="PanelPreparacion" Visibility="Collapsed" Spacing="12"><TextBlock Text="Revisar antes de calcular" Style="{ThemeResource SubtitleTextBlockStyle}"/><TextBlock x:Name="Calidad" TextWrapping="Wrap"/><TextBlock Text="Confirma el significado de cada columna. Los identificadores y fechas se conservan como texto; las conversiones numéricas requieren tu selección." TextWrapping="Wrap"/><StackPanel x:Name="Roles" Spacing="8"/><Button Content="Confirmar roles y guardar revisión" Click="ConfirmarRoles"/><Button Content="Deshacer última preparación" Click="DeshacerPreparacion"/><CheckBox x:Name="ExcluirFaltantes" Content="Confirmo excluir del análisis las filas con faltantes en variables seleccionadas" Checked="InvalidarResultado" Unchecked="InvalidarResultado"/></StackPanel>
<StackPanel x:Name="PanelRuta" Visibility="Collapsed" Spacing="12"><TextBlock Text="Elegir una ruta y revisar condiciones" Style="{ThemeResource SubtitleTextBlockStyle}"/><ComboBox x:Name="TipoAnalisis" Header="Objetivo y método" SelectedIndex="0" SelectionChanged="ModificarParametros" HorizontalAlignment="Stretch"><ComboBoxItem Content="Resumir números"/><ComboBoxItem Content="Resumir cuestionario"/><ComboBoxItem Content="Comparar grupos independientes · Welch"/><ComboBoxItem Content="Comparar mediciones pareadas"/><ComboBoxItem Content="Asociación · Pearson"/><ComboBoxItem Content="Asociación · Spearman"/><ComboBoxItem Content="Relación lineal simple"/></ComboBox><ComboBox x:Name="ColumnaPrimera" Header="Primera variable / respuesta numérica" DisplayMemberPath="Etiqueta" SelectionChanged="ModificarParametros" HorizontalAlignment="Stretch"/><ComboBox x:Name="ColumnaSegunda" Header="Segunda variable / grupo / predictor" DisplayMemberPath="Etiqueta" SelectionChanged="ModificarParametros" HorizontalAlignment="Stretch"/><TextBlock x:Name="Condiciones" TextWrapping="Wrap"/><CheckBox x:Name="ConfirmarPares" Content="Confirmo diseño pareado: cada fila es un mismo individuo medido dos veces" Checked="InvalidarResultado" Unchecked="InvalidarResultado"/><CheckBox x:Name="ConfirmarInferencia" Content="Declaro justificados diseño, independencia y supuestos para inferencia; no implica representatividad" Checked="InvalidarResultado" Unchecked="InvalidarResultado"/><NumberBox x:Name="Confianza" Header="Nivel de confianza" Value="0.95" Minimum="0.8" Maximum="0.99" ValueChanged="CambiarConfianza"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Calcular" Click="Calcular"/><Button Content="Cancelar cálculo" Click="CancelarCalculo"/></StackPanel></StackPanel>
<StackPanel x:Name="PanelResultados" Visibility="Collapsed" Spacing="12"><TextBlock Text="Resultados del análisis" Style="{ThemeResource SubtitleTextBlockStyle}"/><TextBox x:Name="Cifras" Header="Cifras, métodos, recuentos y exclusiones" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap"/><Image x:Name="Figura" MaxHeight="480" AutomationProperties.Name="Gráfico del análisis; consulte cifras y método en el texto de resultados"/></StackPanel>
<StackPanel x:Name="PanelInterpretacion" Visibility="Collapsed" Spacing="12"><TextBlock Text="Interpretar con límites" Style="{ThemeResource SubtitleTextBlockStyle}"/><TextBlock Text="{Binding Interpretacion}" TextWrapping="Wrap"/><TextBlock Text="Un valor p grande no demuestra igualdad. Una asociación o un modelo lineal no establece causalidad. Las unidades y la población deben constar en tu pregunta." TextWrapping="Wrap"/></StackPanel>
<StackPanel x:Name="PanelEvidencia" Visibility="Collapsed" Spacing="12"><TextBlock Text="Conservar y reproducir" Style="{ThemeResource SubtitleTextBlockStyle}"/><CheckBox x:Name="CsvSeguro" Content="Exportar CSV seguro para hojas de cálculo (prefijar texto parecido a fórmulas)" IsChecked="True"/><Button Content="Exportar HTML, CSV, PNG y código R" Click="ExportarInforme"/><Button Content="Exportar proyecto portátil" Click="ExportarProyecto"/><TextBox x:Name="Historial" Header="Historial de solicitudes guardadas" AcceptsReturn="True" IsReadOnly="True"/><TextBlock Text="El archivo portátil incluye datos originales y resultados. Compártelo solo con personas autorizadas. El informe HTML funciona sin conexión." TextWrapping="Wrap"/></StackPanel>
<StackPanel x:Name="PanelConfiguracion" Visibility="Collapsed" Spacing="12"><TextBlock Text="Motor y ayuda" Style="{ThemeResource SubtitleTextBlockStyle}"/><ComboBox x:Name="Motor" Header="Motor de cálculo" SelectedIndex="0"><ComboBoxItem Content="Local"/><ComboBoxItem Content="Docker"/></ComboBox><Button Content="Comprobar motor Docker" Click="ComprobarDocker"/><TextBlock Text="Docker requiere instalación y preparación voluntaria mediante los guiones de desarrollo. Si no está disponible, selecciona Local." TextWrapping="Wrap"/><TextBlock x:Name="EstadoIntegracion" Text="Integración MCP deshabilitada"/><CheckBox x:Name="PermitirCalculos" Content="Permitir cálculos MCP para el proyecto seleccionado"/><CheckBox x:Name="PermitirExportaciones" Content="Permitir exportaciones MCP dentro del proyecto"/><Button Content="Autorizar MCP para este proyecto" Click="AutorizarMcp"/><Button Content="Revocar y deshabilitar MCP" Click="RevocarMcp"/><Button Content="Abrir carpeta de proyectos" Click="AbrirCarpeta"/><TextBlock Text="Ayuda: selecciona Pregunta → Datos → Preparación → Ruta. Para el ejemplo usa c001 (valor) y c002 (grupo) o c003 (predictor). Diagnóstico: anota el código de error y el identificador de solicitud; no compartas datos privados." TextWrapping="Wrap"/></StackPanel>
</StackPanel></ScrollViewer></NavigationView>
<InfoBar Grid.Row="2" IsOpen="True" IsClosable="False" Severity="Informational" Message="{Binding Estado}"/>
</Grid></Window>
