<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="FondoRutaBrush" Color="#FFF2F5F9" />
            <SolidColorBrush x:Key="SuperficieRutaBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SuperficieSecundariaRutaBrush" Color="#FFEAF0F7" />
            <SolidColorBrush x:Key="BordeRutaBrush" Color="#FFD0D9E5" />
            <SolidColorBrush x:Key="TextoSecundarioRutaBrush" Color="#FF42536A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="FondoRutaBrush" Color="#FF151B25" />
            <SolidColorBrush x:Key="SuperficieRutaBrush" Color="#FF202A38" />
            <SolidColorBrush x:Key="SuperficieSecundariaRutaBrush" Color="#FF283547" />
            <SolidColorBrush x:Key="BordeRutaBrush" Color="#FF485971" />
            <SolidColorBrush x:Key="TextoSecundarioRutaBrush" Color="#FFC0CCDC" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="FondoRutaBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SuperficieRutaBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SuperficieSecundariaRutaBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BordeRutaBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextoSecundarioRutaBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
