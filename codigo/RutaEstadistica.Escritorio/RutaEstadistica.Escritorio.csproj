<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.26100.0</TargetFramework><TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion><RootNamespace>RutaEstadistica.Escritorio</RootNamespace><ApplicationManifest>app.manifest</ApplicationManifest><UseWinUI>true</UseWinUI><WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>true</SelfContained><RuntimeIdentifier>win-x64</RuntimeIdentifier><Platforms>x64</Platforms><PlatformTarget>x64</PlatformTarget></PropertyGroup>
<ItemGroup><PackageReference Include="Microsoft.WindowsAppSDK" /><ProjectReference Include="../RutaEstadistica.Aplicacion/RutaEstadistica.Aplicacion.csproj" /></ItemGroup>
<!-- Publicar debe conservar el índice PRI y XBF: el SDK administrado no los copia automáticamente. -->
<Target Name="CopiarRecursosInterfaz" AfterTargets="Publish"><ItemGroup><RecursosInterfaz Include="$(TargetDir)*.xbf;$(TargetDir)$(MSBuildProjectName).pri" /></ItemGroup><Error Condition="!Exists('$(TargetDir)$(MSBuildProjectName).pri')" Text="INTERFAZ_RECURSOS_AUSENTES" /><Copy SourceFiles="@(RecursosInterfaz)" DestinationFolder="$(PublishDir)" /></Target>
</Project>
